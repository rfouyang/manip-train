# ClearML 云端（app.clear.ml → Settings → Workspace → Create new credentials）
CLEARML_API_HOST=https://api.clear.ml
CLEARML_WEB_HOST=https://app.clear.ml
CLEARML_FILES_HOST=https://files.clear.ml
CLEARML_API_ACCESS_KEY=
CLEARML_API_SECRET_KEY=
# false 时只写本地日志，不连 ClearML（没有凭证时自动为 false）
MANIP_TRAIN_CLEARML=true
# 训练输出（checkpoint、导出包、评估报告）；相对路径以仓库根目录为基准
MANIP_TRAIN_OUTPUT_DIR=output
# manip-data-platform 输出的数据集目录，experiment yaml 中用 ${MANIP_TRAIN_DATA_DIR} 引用
MANIP_TRAIN_DATA_DIR=data
MANIP_TRAIN_LOG_LEVEL=INFO
